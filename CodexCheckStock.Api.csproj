    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="sql\**\*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
